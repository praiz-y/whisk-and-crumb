SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=any-random-string-at-least-32-characters-long

# The admin password itself lives in the admin_credentials table (see
# supabase/schema.sql), not an env var — it's changeable from the Settings
# page without a redeploy. Use scripts/hash-password.ts to generate the
# initial hash to seed that table with.
